//@version=6
// Seasonality Projektion
// Berechnet aus der Kurshistorie des Charts (keine externen Daten), wie sich der Kurs in den
// ausgewählten Jahren im Schnitt ab dem heutigen Kalendertag entwickelt hat, und zeichnet diesen
// Durchschnittsverlauf als Projektion X Tage in die Zukunft. Dazu: Trefferquote und ein frei
// wählbares Analysefenster (z. B. 01.03.–15.04.).
// Bitte auf dem TAGESCHART (D) verwenden.
indicator("Seasonality Projektion", "Saison", overlay = true, max_polylines_count = 100)

// ───────── Eingaben ─────────
grpD = "Datenbasis"
int  yFrom   = input.int(2010, "Von Jahr", minval = 1900, maxval = 2100, group = grpD)
int  yTo     = input.int(2026, "Bis Jahr", minval = 1900, maxval = 2100, group = grpD)
bool exclCur = input.bool(true, "Laufendes Jahr ausschließen", group = grpD)

grpP = "Projektion"
int   fwd      = input.int(14, "Tage voraus (Kalendertage)", minval = 1, maxval = 365, group = grpP)
int   back     = input.int(0, "Saisonkurve zusätzlich rückwärts zeigen (Tage)", minval = 0, maxval = 365, group = grpP, tooltip = "Zeigt, wie der saisonale Durchschnitt in den letzten X Tagen verlaufen wäre – zum Vergleich mit dem tatsächlichen Kurs")
bool  showYears = input.bool(false, "Einzelne Jahre als dünne Linien anzeigen", group = grpP)
color colAvg   = input.color(color.orange, "Farbe Durchschnitt", group = grpP)
color colYear  = input.color(color.new(color.gray, 60), "Farbe Einzeljahre", group = grpP)

grpW = "Analysefenster (eigener Zeitraum im Jahr)"
bool useWin = input.bool(true, "Analysefenster auswerten", group = grpW)
int  wSM    = input.int(3, "Start – Monat", minval = 1, maxval = 12, group = grpW, inline = "s")
int  wSD    = input.int(1, "Tag", minval = 1, maxval = 31, group = grpW, inline = "s")
int  wEM    = input.int(4, "Ende – Monat", minval = 1, maxval = 12, group = grpW, inline = "e")
int  wED    = input.int(15, "Tag", minval = 1, maxval = 31, group = grpW, inline = "e")

bool showTable = input.bool(true, "Tabelle anzeigen", group = "Anzeige")

// ───────── Hilfsfunktionen ─────────
const int MAXY = 100
const int DAY  = 86400000

f_doy(int t) =>
    int(math.floor((t - timestamp("UTC", year(t, "UTC"), 1, 1, 0, 0)) / DAY)) + 1

// Schlusskurs eines Kalendertags (Zeile = Jahr, Spalte = Tag im Jahr).
// Fällt der Tag auf ein Wochenende/Feiertag, wird der letzte Kurs davor genommen (max. 6 Tage zurück).
var int baseYear = year(time_tradingday, "UTC")
var matrix<float> px = matrix.new<float>(MAXY, 367, na)

f_px(int r, int d) =>
    float v = na
    for i = 0 to 6
        if na(v)
            int r2 = r
            int d2 = d - i
            while d2 < 1
                r2 -= 1
                d2 += 365
            while d2 > 365
                r2 += 1
                d2 -= 365
            if r2 >= 0 and r2 < MAXY
                v := px.get(r2, d2)
    v

// ───────── Daten sammeln ─────────
bool isDaily = timeframe.isdaily and timeframe.multiplier == 1
int  rowNow  = year(time_tradingday, "UTC") - baseYear
if isDaily and rowNow >= 0 and rowNow < MAXY
    px.set(rowNow, math.min(f_doy(time_tradingday), 365), close)

// ───────── Auswertung am letzten Balken ─────────
var polyline   avgLine   = na
var polyline[] yearLines = array.new<polyline>()
var table      tb        = table.new(position.top_right, 2, 6, bgcolor = color.new(color.gray, 85), border_width = 1)

f_pct(float v) => na(v) ? "–" : (v >= 0 ? "+" : "") + str.tostring(v * 100, "#.##") + " %"
f_two(int v) => v < 10 ? "0" + str.tostring(v) : str.tostring(v)

if barstate.islast
    if not isDaily
        if showTable
            tb.cell(0, 0, "Bitte Tageschart (D) verwenden", text_color = color.red)
    else
        int d0   = math.min(f_doy(time_tradingday), 365)
        int yCur = year(time_tradingday, "UTC")
        int yEnd = exclCur ? math.min(yTo, yCur - 1) : yTo
        int K    = back + fwd + 1

        float[] sums = array.new_float(K, 0.0)
        int[]   cnts = array.new_int(K, 0)
        int   nY = 0
        int   nUp = 0
        float sumRet = 0.0
        int   yMin = 9999
        int   yMax = 0

        // alte Einzeljahr-Linien löschen
        for pl in yearLines
            pl.delete()
        yearLines.clear()

        for y = yFrom to yEnd
            int r = y - baseYear
            if r >= 0 and r < MAXY
                float p0 = f_px(r, d0)
                float pE = f_px(r, d0 + fwd)
                if not na(p0) and not na(pE)
                    nY += 1
                    float ret = pE / p0 - 1
                    sumRet += ret
                    nUp += ret > 0 ? 1 : 0
                    yMin := math.min(yMin, y)
                    yMax := math.max(yMax, y)
                    chart.point[] yp = array.new<chart.point>()
                    for k = -back to fwd
                        float p = f_px(r, d0 + k)
                        if not na(p)
                            int idx = k + back
                            sums.set(idx, sums.get(idx) + p / p0)
                            cnts.set(idx, cnts.get(idx) + 1)
                            if showYears
                                yp.push(chart.point.from_time(time + k * DAY, close * p / p0))
                    if showYears and yp.size() > 1 and yearLines.size() < 90
                        yearLines.push(polyline.new(yp, xloc = xloc.bar_time, line_color = colYear, line_width = 1))

        // Durchschnittslinie
        avgLine.delete()
        chart.point[] pts = array.new<chart.point>()
        for k = -back to fwd
            int idx = k + back
            if cnts.get(idx) > 0
                pts.push(chart.point.from_time(time + k * DAY, close * sums.get(idx) / cnts.get(idx)))
        if pts.size() > 1
            avgLine := polyline.new(pts, xloc = xloc.bar_time, line_color = colAvg, line_width = 3)

        // Analysefenster
        int   wN = 0
        int   wUp = 0
        float wSum = 0.0
        if useWin
            for y = yFrom to yEnd
                int r = y - baseYear
                if r >= 0 and r < MAXY
                    int ds = f_doy(timestamp("UTC", y, wSM, wSD, 0, 0))
                    int de = f_doy(timestamp("UTC", y, wEM, wED, 0, 0))
                    int deAbs = de >= ds ? de : de + 365      // Fenster über den Jahreswechsel
                    float a = f_px(r, ds)
                    float b = f_px(r, deAbs)
                    if not na(a) and not na(b)
                        float rr = b / a - 1
                        wN += 1
                        wSum += rr
                        wUp += rr > 0 ? 1 : 0

        if showTable
            tb.cell(0, 0, "Seasonality", text_size = size.small)
            tb.cell(1, 0, nY > 0 ? str.tostring(nY) + " Jahre (" + str.tostring(yMin) + "–" + str.tostring(yMax) + ")" : "keine Daten", text_size = size.small)
            tb.cell(0, 1, "Nächste " + str.tostring(fwd) + " Tage Ø", text_size = size.small)
            tb.cell(1, 1, nY > 0 ? f_pct(sumRet / nY) : "–", text_size = size.small, text_color = nY > 0 and sumRet > 0 ? color.green : color.red)
            tb.cell(0, 2, "davon steigend", text_size = size.small)
            tb.cell(1, 2, nY > 0 ? str.tostring(100.0 * nUp / nY, "#") + " % der Jahre" : "–", text_size = size.small)
            if useWin
                string wTxt = f_two(wSD) + "." + f_two(wSM) + ".–" + f_two(wED) + "." + f_two(wEM) + "."
                tb.cell(0, 3, "Fenster " + wTxt + " Ø", text_size = size.small)
                tb.cell(1, 3, wN > 0 ? f_pct(wSum / wN) : "–", text_size = size.small, text_color = wN > 0 and wSum > 0 ? color.green : color.red)
                tb.cell(0, 4, "davon steigend", text_size = size.small)
                tb.cell(1, 4, wN > 0 ? str.tostring(100.0 * wUp / wN, "#") + " % (" + str.tostring(wN) + " Jahre)" : "–", text_size = size.small)
