//@version=6
// Sentiment Fear & Greed – eigener Angst/Gier-Index pro Asset aus TradingView-Daten.
// Jeder Baustein wird auf 0–100 umgerechnet (Lage im Vergleich zur eigenen Historie),
// der Durchschnitt ergibt den Score. Grün = Gier (bullishes Sentiment), Rot = Angst (bearishes Sentiment).
// Gedacht für den Tageschart (1D).
indicator("Sentiment Fear & Greed", "Sentiment", overlay = true)

// ───────── Allgemein ─────────
grpG = "Allgemein"
string assetIn   = input.string("Auto", "Asset", options = ["Auto", "S&P 500", "Nasdaq", "DAX", "Gold", "Silber"], group = grpG, tooltip = "Auto erkennt das Asset am Chart-Symbol. Falls die Erkennung nicht passt, hier fest einstellen.")
int    len       = input.int(252, "Historie (Bars)", minval = 50, maxval = 2000, group = grpG, tooltip = "252 = ca. 1 Jahr auf dem Tageschart")
int    smoothLen = input.int(5, "Glättung (EMA)", minval = 1, group = grpG)

// ───────── Zonen & Farben ─────────
grpZ = "Zonen & Farben"
float greedLvl  = input.float(60, "Gier ab", minval = 50, maxval = 100, group = grpZ)
float extGreed  = input.float(75, "Extreme Gier ab", minval = 50, maxval = 100, group = grpZ)
float fearLvl   = input.float(40, "Angst bis", minval = 0, maxval = 50, group = grpZ)
float extFear   = input.float(25, "Extreme Angst bis", minval = 0, maxval = 50, group = grpZ)
color colG      = input.color(color.green, "Farbe Gier", group = grpZ)
color colR      = input.color(color.red, "Farbe Angst", group = grpZ)
int   transp    = input.int(88, "Transparenz normal", minval = 0, maxval = 100, group = grpZ)
int   transpExt = input.int(72, "Transparenz extrem", minval = 0, maxval = 100, group = grpZ)
bool  showArrows = input.bool(true, "Marker bei Eintritt in Extremzone", group = grpZ)
bool  showTable  = input.bool(true, "Info-Tabelle anzeigen", group = grpZ)
string tablePos  = input.string("Mitte rechts", "Tabellen-Position", options = ["Oben rechts", "Mitte rechts", "Unten rechts", "Oben links", "Unten links"], group = grpZ)

// ───────── Bausteine an/aus ─────────
grpB = "Bausteine"
bool useMom = input.bool(true, "Momentum (Kurs vs. 125-Tage-Linie)", group = grpB)
bool useStr = input.bool(true, "Kursstärke (Lage in 52-Wochen-Spanne)", group = grpB)
bool useVol = input.bool(true, "Volatilitätsindex (invertiert)", group = grpB)
bool useRV  = input.bool(true, "Ersatz: realisierte Volatilität, falls kein Vola-Index", group = grpB)
bool usePC  = input.bool(true, "Put/Call-Ratio (nur US-Indizes)", group = grpB)
bool useBr  = input.bool(true, "Marktbreite (% Aktien über 200-Tage-Linie)", group = grpB)
bool useSh  = input.bool(true, "Aktien vs. Anleihen (nur Aktienindizes)", group = grpB)
bool useCr  = input.bool(true, "Junk Bonds vs. Staatsanleihen (nur Aktienindizes)", group = grpB)

// ───────── Symbole (anpassbar, falls eines nicht geladen wird) ─────────
grpS = "Symbole"
string vixSym   = input.symbol("CBOE:VIX", "Vola S&P 500", group = grpS)
string vxnSym   = input.symbol("CBOE:VXN", "Vola Nasdaq", group = grpS)
string vdaxSym  = input.string("", "Vola DAX (z. B. VDAX, falls verfügbar)", group = grpS)
string gvzSym   = input.symbol("CBOE:GVZ", "Vola Gold", group = grpS)
string vxslvSym = input.symbol("CBOE:VXSLV", "Vola Silber", group = grpS)
string pcSym    = input.symbol("USI:PCC", "Put/Call-Ratio", group = grpS)
string spxBrSym = input.symbol("INDEX:S5TH", "Marktbreite S&P 500", group = grpS)
string ndxBrSym = input.symbol("INDEX:NDTH", "Marktbreite Nasdaq", group = grpS)
string daxBrSym = input.string("", "Marktbreite DAX (leer = aus)", group = grpS)
string bondSym  = input.symbol("NASDAQ:TLT", "Staatsanleihen (Safe Haven)", group = grpS)
string hySym    = input.symbol("AMEX:HYG", "Junk Bonds", group = grpS)
string igSym    = input.symbol("NASDAQ:IEF", "Staatsanleihen mittel", group = grpS)

// ───────── Asset-Erkennung ─────────
f_detect() =>
    string r = str.upper(syminfo.root)
    string t = str.upper(syminfo.ticker)
    string d = str.upper(syminfo.description)
    bool silver = r == "SI" or r == "SIL" or str.contains(t, "XAG") or t == "SLV" or str.startswith(d, "SILBER") or str.startswith(d, "SILVER")
    bool gold   = r == "GC" or r == "MGC" or str.contains(t, "XAU") or t == "GLD" or str.startswith(d, "GOLD ")
    bool ndx    = r == "NQ" or r == "MNQ" or t == "NDX" or t == "NAS100" or t == "US100" or t == "QQQ" or str.contains(d, "NASDAQ 100") or str.contains(d, "NASDAQ-100")
    bool spx    = r == "ES" or r == "MES" or t == "SPX" or t == "US500" or t == "SPX500" or t == "SPY" or str.contains(d, "S&P 500")
    bool dax    = r == "FDAX" or r == "FDXM" or r == "FDXS" or t == "DAX" or t == "DE40" or t == "GER40" or t == "DEU40" or t == "GER30" or str.contains(d, "DAX")
    silver ? "Silber" : gold ? "Gold" : ndx ? "Nasdaq" : spx ? "S&P 500" : dax ? "DAX" : "Unbekannt"

string asset   = assetIn == "Auto" ? f_detect() : assetIn
bool   isUS    = asset == "S&P 500" or asset == "Nasdaq"
bool   isEq    = isUS or asset == "DAX"

string volSym = asset == "S&P 500" ? vixSym : asset == "Nasdaq" ? vxnSym : asset == "DAX" ? vdaxSym : asset == "Gold" ? gvzSym : asset == "Silber" ? vxslvSym : ""
string brSym  = asset == "S&P 500" ? spxBrSym : asset == "Nasdaq" ? ndxBrSym : asset == "DAX" ? daxBrSym : ""

// ───────── Daten holen ─────────
f_close(string sym) =>
    string s = sym == "" ? syminfo.tickerid : sym
    float v = request.security(s, timeframe.period, close, ignore_invalid_symbol = true)
    sym != "" ? v : na

float volIdx = f_close(volSym)
float pc     = f_close(isUS ? pcSym : "")
float br     = f_close(brSym)
float bond   = f_close(isEq ? bondSym : "")
float hy     = f_close(isEq ? hySym : "")
float ig     = f_close(isEq ? igSym : "")

// ───────── Bausteine (0 = Angst, 100 = Gier) ─────────
float c_mom = ta.percentrank(close / ta.sma(close, 125) - 1, len)

float hi52  = ta.highest(high, len)
float lo52  = ta.lowest(low, len)
float c_str = hi52 > lo52 ? (close - lo52) / (hi52 - lo52) * 100 : na

float c_vix = 100 - ta.percentrank(volIdx, len)
float rv    = ta.stdev(math.log(close / close[1]), 20)
float c_rv  = 100 - ta.percentrank(rv, len)
bool  volIsRV = na(c_vix)
float c_vol = not volIsRV ? c_vix : useRV ? c_rv : na

float c_pc = 100 - ta.percentrank(ta.ema(pc, 5), len)
float c_br = math.max(0, math.min(100, br))
float c_sh = ta.percentrank(ta.roc(close, 20) - ta.roc(bond, 20), len)
float c_cr = ta.percentrank(ta.roc(hy / ig, 20), len)

// ───────── Score ─────────
float v_mom = useMom ? c_mom : na
float v_str = useStr ? c_str : na
float v_vol = useVol ? c_vol : na
float v_pc  = usePC and isUS ? c_pc : na
float v_br  = useBr and brSym != "" ? c_br : na
float v_sh  = useSh and isEq ? c_sh : na
float v_cr  = useCr and isEq ? c_cr : na

array<float> vals = array.from(v_mom, v_str, v_vol, v_pc, v_br, v_sh, v_cr)
float sum = 0.0
int   cnt = 0
for v in vals
    if not na(v)
        sum += v
        cnt += 1
float raw   = cnt > 0 ? sum / cnt : na
float score = ta.ema(raw, smoothLen)

// ───────── Färbung ─────────
color bg = na(score) ? na : score >= extGreed ? color.new(colG, transpExt) : score >= greedLvl ? color.new(colG, transp) : score <= extFear ? color.new(colR, transpExt) : score <= fearLvl ? color.new(colR, transp) : na
bgcolor(bg, title = "Sentiment-Hintergrund")

bool newExtGreed = score >= extGreed and score[1] < extGreed
bool newExtFear  = score <= extFear and score[1] > extFear
plotshape(showArrows and newExtGreed, "Extreme Gier", shape.triangleup, location.belowbar, color.new(colG, 0), size = size.small)
plotshape(showArrows and newExtFear, "Extreme Angst", shape.triangledown, location.abovebar, color.new(colR, 0), size = size.small)
plot(score, "Sentiment-Score", display = display.data_window)

alertcondition(newExtGreed, "Sentiment Extreme Gier", "Sentiment erreicht EXTREME GIER auf {{ticker}}")
alertcondition(newExtFear, "Sentiment Extreme Angst", "Sentiment erreicht EXTREME ANGST auf {{ticker}}")

// ───────── Info-Tabelle ─────────
f_label(float s) =>
    na(s) ? "n/a" : s >= extGreed ? "Extreme Gier" : s >= greedLvl ? "Gier" : s <= extFear ? "Extreme Angst" : s <= fearLvl ? "Angst" : "Neutral"

f_cellCol(float s) =>
    na(s) ? color.new(color.gray, 85) : s >= greedLvl ? color.new(colG, 70) : s <= fearLvl ? color.new(colR, 70) : color.new(color.gray, 85)

string pos = tablePos == "Oben rechts" ? position.top_right : tablePos == "Unten rechts" ? position.bottom_right : tablePos == "Oben links" ? position.top_left : tablePos == "Unten links" ? position.bottom_left : position.middle_right
var table info = table.new(pos, 2, 10, bgcolor = color.new(color.gray, 85), border_width = 1)

f_row(int row, string name, float v, bool applicable) =>
    info.cell(0, row, name, text_size = size.small, text_color = chart.fg_color, text_halign = text.align_left)
    string txt = not applicable ? "–" : na(v) ? "n/a" : str.tostring(v, "#")
    info.cell(1, row, txt, text_size = size.small, text_color = chart.fg_color, bgcolor = applicable ? f_cellCol(v) : color.new(color.gray, 85))

if showTable and barstate.islast
    info.cell(0, 0, "Sentiment · " + asset, text_size = size.small, text_color = chart.fg_color, text_halign = text.align_left)
    info.cell(1, 0, f_label(score), text_size = size.small, text_color = chart.fg_color, bgcolor = f_cellCol(score))
    f_row(1, "Score (0–100)", score, true)
    f_row(2, "Momentum 125", c_mom, useMom)
    f_row(3, "Kursstärke 52W", c_str, useStr)
    f_row(4, volIsRV ? "Vola (realisiert)" : "Vola-Index", c_vol, useVol)
    f_row(5, "Put/Call", c_pc, usePC and isUS)
    f_row(6, "Marktbreite", c_br, useBr and brSym != "")
    f_row(7, "Aktien vs. Anleihen", c_sh, useSh and isEq)
    f_row(8, "Junk Bonds", c_cr, useCr and isEq)
    f_row(9, "Aktive Bausteine", cnt, true)
