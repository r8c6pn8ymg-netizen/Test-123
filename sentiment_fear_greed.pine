//@version=6
// Sentiment Fear & Greed v2 – schneller Stimmungs-Oszillator (0 = Panik, 100 = Euphorie).
// Bausteine: RSI, Lage in der Kursspanne (Stochastik), Abstand zum Durchschnitt (Z-Score),
// optional ein Volatilitätsindex (VIX & Co.).
// Kontra-Modus (Standard): extreme Gier = ROT (Top-Gefahr), extreme Angst = GRÜN (Tief-Chance).
// Marker erscheinen erst, wenn die Extremstimmung KIPPT – das sind die eigentlichen Signale.
indicator("Sentiment Fear & Greed v2", "Sentiment v2", overlay = true)

// ───────── Allgemein ─────────
grpG = "Allgemein"
string mode     = input.string("Kontra-Signal", "Anzeige", options = ["Kontra-Signal", "Stimmung direkt"], group = grpG, tooltip = "Kontra-Signal: Gier = rot, Angst = grün.\nStimmung direkt: Gier = grün, Angst = rot.")
int   rsiLen    = input.int(9, "RSI-Länge", minval = 2, group = grpG)
int   stLen     = input.int(13, "Spannen-Länge (Stochastik)", minval = 2, group = grpG)
int   zLen      = input.int(20, "Durchschnitt-Länge (Z-Score)", minval = 5, group = grpG)
int   smoothLen = input.int(1, "Glättung (1 = aus)", minval = 1, group = grpG, tooltip = "Höher = ruhiger, aber später")

// ───────── Zonen ─────────
grpZ = "Zonen & Signale"
float greedLvl  = input.float(80, "Gier-Zone ab", minval = 50, maxval = 100, group = grpZ)
float extGreed  = input.float(85, "Extreme Gier ab", minval = 50, maxval = 100, group = grpZ)
float fearLvl   = input.float(20, "Angst-Zone bis", minval = 0, maxval = 50, group = grpZ)
float extFear   = input.float(15, "Extreme Angst bis", minval = 0, maxval = 50, group = grpZ)
float topCross  = input.float(70, "Top-Signal, wenn Score darunter fällt", minval = 50, maxval = 100, group = grpZ)
float lowCross  = input.float(30, "Tief-Signal, wenn Score darüber steigt", minval = 0, maxval = 50, group = grpZ)
int   sigLook   = input.int(4, "Extrem muss in den letzten X Bars gewesen sein", minval = 1, group = grpZ)

// ───────── Optik ─────────
grpA = "Anzeige"
color colRed    = input.color(color.red, "Rot", group = grpA)
color colGreen  = input.color(color.green, "Grün", group = grpA)
int   transp    = input.int(85, "Transparenz Zone", minval = 0, maxval = 100, group = grpA)
int   transpExt = input.int(70, "Transparenz extrem", minval = 0, maxval = 100, group = grpA)
bool  showZones = input.bool(true, "Hintergrund-Zonen anzeigen", group = grpA)
bool  showSig   = input.bool(true, "Signal-Marker anzeigen", group = grpA)
bool  showTable = input.bool(true, "Info-Tabelle anzeigen", group = grpA)
string tablePos = input.string("Mitte rechts", "Tabellen-Position", options = ["Oben rechts", "Mitte rechts", "Unten rechts", "Oben links", "Unten links"], group = grpA)

// ───────── Optional: Volatilitätsindex ─────────
grpV = "Volatilitätsindex (optional)"
bool   useVol  = input.bool(false, "Vola-Index einbeziehen", group = grpV, tooltip = "Hoher VIX = Angst. Wird invertiert und als 4. Baustein gemittelt.")
int    volLen  = input.int(52, "Vola-Vergleichszeitraum (Bars)", minval = 10, group = grpV)
string volSym  = input.symbol("CBOE:VIX", "Vola-Symbol", group = grpV, tooltip = "S&P/Dow: CBOE:VIX · Nasdaq: CBOE:VXN · Gold: CBOE:GVZ · Silber: CBOE:VXSLV")

// ───────── Bausteine (0 = Angst, 100 = Gier) ─────────
float c_rsi = ta.rsi(close, rsiLen)

float lo   = ta.lowest(low, stLen)
float hi   = ta.highest(high, stLen)
float c_st = hi > lo ? (close - lo) / (hi - lo) * 100 : 50

float sd  = ta.stdev(close, zLen)
float c_z = sd > 0 ? math.max(0, math.min(100, 50 + 20 * (close - ta.sma(close, zLen)) / sd)) : 50

float volIdx = request.security(volSym, timeframe.period, close, ignore_invalid_symbol = true)
float volPr  = ta.percentrank(volIdx, volLen)
float c_vol  = useVol and not na(volIdx) ? 100 - volPr : na

// ───────── Score ─────────
array<float> vals = array.from(c_rsi, c_st, c_z, c_vol)
float sum = 0.0
int   cnt = 0
for v in vals
    if not na(v)
        sum += v
        cnt += 1
float raw   = cnt > 0 ? sum / cnt : na
float score = smoothLen > 1 ? ta.ema(raw, smoothLen) : raw

// ───────── Farben ─────────
bool  kontra   = mode == "Kontra-Signal"
color colGreed = kontra ? colRed : colGreen
color colFear  = kontra ? colGreen : colRed

color bg = na
if showZones and not na(score)
    if score >= extGreed
        bg := color.new(colGreed, transpExt)
    else if score >= greedLvl
        bg := color.new(colGreed, transp)
    else if score <= extFear
        bg := color.new(colFear, transpExt)
    else if score <= fearLvl
        bg := color.new(colFear, transp)
bgcolor(bg, title = "Sentiment-Hintergrund")

// ───────── Signale: Extremstimmung kippt ─────────
bool topSig = ta.highest(score, sigLook) >= extGreed and ta.crossunder(score, topCross)
bool lowSig = ta.lowest(score, sigLook) <= extFear and ta.crossover(score, lowCross)
plotshape(showSig and topSig, "Top-Signal (Gier kippt)", shape.triangledown, location.abovebar, color.new(colGreed, 0), size = size.small)
plotshape(showSig and lowSig, "Tief-Signal (Angst dreht)", shape.triangleup, location.belowbar, color.new(colFear, 0), size = size.small)
plot(score, "Sentiment-Score", display = display.data_window)

alertcondition(topSig, "Top-Signal", "Sentiment: extreme Gier kippt auf {{ticker}}")
alertcondition(lowSig, "Tief-Signal", "Sentiment: extreme Angst dreht auf {{ticker}}")
alertcondition(ta.crossover(score, extGreed), "Extreme Gier erreicht", "Sentiment: EXTREME GIER auf {{ticker}}")
alertcondition(ta.crossunder(score, extFear), "Extreme Angst erreicht", "Sentiment: EXTREME ANGST auf {{ticker}}")

// ───────── Info-Tabelle ─────────
f_label(float s) =>
    na(s) ? "n/a" : s >= extGreed ? "Extreme Gier" : s >= greedLvl ? "Gier" : s <= extFear ? "Extreme Angst" : s <= fearLvl ? "Angst" : "Neutral"

f_cellCol(float s) =>
    na(s) ? color.new(color.gray, 85) : s >= greedLvl ? color.new(colGreed, 70) : s <= fearLvl ? color.new(colFear, 70) : color.new(color.gray, 85)

string pos = tablePos == "Oben rechts" ? position.top_right : tablePos == "Unten rechts" ? position.bottom_right : tablePos == "Oben links" ? position.top_left : tablePos == "Unten links" ? position.bottom_left : position.middle_right
var table info = table.new(pos, 2, 6, bgcolor = color.new(color.gray, 85), border_width = 1)

f_row(int row, string name, float v, bool active) =>
    info.cell(0, row, name, text_size = size.small, text_color = chart.fg_color, text_halign = text.align_left)
    info.cell(1, row, not active ? "–" : na(v) ? "n/a" : str.tostring(v, "#"), text_size = size.small, text_color = chart.fg_color, bgcolor = active ? f_cellCol(v) : color.new(color.gray, 85))

if showTable and barstate.islast
    info.cell(0, 0, "Sentiment", text_size = size.small, text_color = chart.fg_color, text_halign = text.align_left)
    info.cell(1, 0, f_label(score), text_size = size.small, text_color = chart.fg_color, bgcolor = f_cellCol(score))
    f_row(1, "Score (0–100)", score, true)
    f_row(2, "RSI " + str.tostring(rsiLen), c_rsi, true)
    f_row(3, "Spanne " + str.tostring(stLen), c_st, true)
    f_row(4, "Z-Score " + str.tostring(zLen), c_z, true)
    f_row(5, "Vola-Index", c_vol, useVol)
